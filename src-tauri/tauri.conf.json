{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Confluence Export Desktop",
  "mainBinaryName": "confluence-export-desktop",
  "version": "2.0.0",
  "identifier": "com.confluenceexport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Confluence Export Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
